# ==================================================
# Home Improvements Business - Environment Variables
# ==================================================
# Copy this file to .env.local and fill in your values

# ----- Database -----
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/home-improvements
REDIS_URL=redis://localhost:6379

# ----- Authentication -----
JWT_SECRET=your-secure-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=your-secure-refresh-secret-min-32-chars

# ----- Cloudflare R2 (File Storage) -----
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=home-improvements-files
R2_PUBLIC_URL=https://files.yourdomain.com

# ----- OpenAI (Whisper & GPT-4) -----
OPENAI_API_KEY=sk-your-openai-api-key

# ----- Microsoft Graph (Teams Integration) -----
AZURE_CLIENT_ID=your-azure-app-client-id
AZURE_CLIENT_SECRET=your-azure-app-client-secret
AZURE_TENANT_ID=your-azure-tenant-id
TEAMS_ORGANIZER_USER_ID=your-microsoft-user-id

# ----- Twilio (WhatsApp/SMS) -----
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SMS_NUMBER=+1234567890

# ----- Email (SendGrid) -----
SENDGRID_API_KEY=SG.your-sendgrid-api-key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Your Business Name

# ----- Application URLs -----
NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ----- Admin Credentials (Initial Setup) -----
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your-secure-admin-password

# ----- Environment -----
NODE_ENV=development
PORT=4000
